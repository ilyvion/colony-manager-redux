<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="ilyvion.Laboratory.PatchOperationFindModById">
        <mods>
            <li>vanillaexpanded.gravship</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="VGE_GravjumperEngine"]/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
                    <value>
                        <li>CM_ManagerDatabase</li>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="VGE_GravhulkEngine"]/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
                    <value>
                        <li>CM_ManagerDatabase</li>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>
</Patch>
