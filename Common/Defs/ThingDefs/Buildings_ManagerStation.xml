<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BuildingBase">
        <defName>CMR_ManagingSpot</defName>
        <label>managing spot</label>
        <description>A workplace for a manager, lacking the necessary tools and thus operating very inefficiently.</description>
        <thingClass>ColonyManagerRedux.Building_ManagerStation</thingClass>
        <graphicData>
            <texPath>Buildings/CMR_ManagingSpot</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1,1)</drawSize>
        </graphicData>
        <altitudeLayer>FloorEmplacement</altitudeLayer>
        <useHitPoints>false</useHitPoints>
        <statBases>
            <WorkToBuild>0</WorkToBuild>
            <WorkTableEfficiencyFactor>0.5</WorkTableEfficiencyFactor>
        </statBases>
        <scatterableOnMapGen>false</scatterableOnMapGen>
        <size>(1,1)</size>
        <designationCategory>Production</designationCategory>
        <passability>Standable</passability>
        <hasInteractionCell>True</hasInteractionCell>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <surfaceType>Item</surfaceType>
        <building>
            <sowTag>SupportPlantsOnly</sowTag>
            <canPlaceOverImpassablePlant>false</canPlaceOverImpassablePlant>
            <ai_chillDestination>false</ai_chillDestination>
            <wakeDormantPawnsOnConstruction>false</wakeDormantPawnsOnConstruction>
            <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
            <buildingTags>
                <li>Production</li>
            </buildingTags>
        </building>
        <comps>
            <li Class="ColonyManagerRedux.CompProperties_ManagerStation">
                <speed>1000</speed>
            </li>
            <li Class="CompProperties_Forbiddable" />
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>ToolCabinet</li>
                </linkableFacilities>
            </li>
            <li Class="CompProperties_ReportWorkSpeed">
                <workSpeedStat>WorkTableWorkSpeedFactor</workSpeedStat>
            </li>
        </comps>
        <placeWorkers>
            <li>PlaceWorker_ShowFacilitiesConnections</li>
            <li>PlaceWorker_ReportWorkSpeedPenalties</li>
            <li>PlaceWorker_PreventInteractionSpotOverlap</li>
        </placeWorkers>
        <researchPrerequisites>
            <li>CMR_ManagingSpot</li>
        </researchPrerequisites>
    </ThingDef>
    <!-- ========================= Work tables ==========================-->
    <ThingDef ParentName="BenchBase">
        <defName>CM_BasicManagerStation</defName>
        <label>basic manager desk</label>
        <thingClass>ColonyManagerRedux.Building_ManagerStation</thingClass>
        <description>A simple table with all the stationary required to allow a manager to do his work.</description>
        <graphicData>
            <texPath>Buildings/BasicManagerStation</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>(3.5,1.5)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.20</staticSunShadowHeight>
        <altitudeLayer>Building</altitudeLayer>
        <costStuffCount>75</costStuffCount>
        <stuffCategories>
            <li>Metallic</li>
            <li>Woody</li>
            <li>Stony</li>
        </stuffCategories>
        <fillPercent>0.5</fillPercent>
        <useHitPoints>True</useHitPoints>
        <statBases>
            <WorkToBuild>2000</WorkToBuild>
            <MaxHitPoints>180</MaxHitPoints>
            <Flammability>1.0</Flammability>
        </statBases>
        <size>(3,1)</size>
        <designationCategory>Production</designationCategory>
        <passability>PassThroughOnly</passability>
        <pathCost>60</pathCost>
        <hasInteractionCell>True</hasInteractionCell>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <surfaceType>Item</surfaceType>
        <tickerType>Normal</tickerType>
        <building>
            <paintable>true</paintable>
        </building>
        <comps>
            <li Class="ColonyManagerRedux.CompProperties_ManagerStation">
                <speed>1000</speed>
            </li>
            <li Class="CompProperties_Forbiddable" />
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>ToolCabinet</li>
                </linkableFacilities>
            </li>
        </comps>
        <researchPrerequisites>
            <li>CMR_ManagingDesk</li>
        </researchPrerequisites>
        <placeWorkers>
            <li>PlaceWorker_ShowFacilitiesConnections</li>
            <li>PlaceWorker_PreventInteractionSpotOverlap</li>
        </placeWorkers>
    </ThingDef>
    <ThingDef ParentName="BenchBase">
        <defName>CM_ManagerStation</defName>
        <label>manager desk</label>
        <thingClass>ColonyManagerRedux.Building_ManagerStation</thingClass>
        <description>A desk with a computer and all the stationary required to allow a manager to do his work efficiently.</description>
        <graphicData>
            <texPath>Buildings/ManagerStation</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>(3.5,1.5)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.20</staticSunShadowHeight>
        <altitudeLayer>Building</altitudeLayer>
        <costStuffCount>100</costStuffCount>
        <costList>
            <Steel>50</Steel>
            <Silver>1</Silver>
        </costList>
        <stuffCategories>
            <li>Metallic</li>
            <li>Woody</li>
            <li>Stony</li>
        </stuffCategories>
        <fillPercent>0.5</fillPercent>
        <useHitPoints>True</useHitPoints>
        <statBases>
            <WorkToBuild>3000</WorkToBuild>
            <MaxHitPoints>180</MaxHitPoints>
            <Flammability>1.0</Flammability>
        </statBases>
        <size>(3,1)</size>
        <designationCategory>Production</designationCategory>
        <passability>PassThroughOnly</passability>
        <pathCost>60</pathCost>
        <hasInteractionCell>True</hasInteractionCell>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <surfaceType>Item</surfaceType>
        <tickerType>Normal</tickerType>
        <building>
            <paintable>true</paintable>
        </building>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>100</basePowerConsumption>
                <shortCircuitInRain>true</shortCircuitInRain>
                <soundPowerOn>Power_OnSmall</soundPowerOn>
                <soundPowerOff>Power_OffSmall</soundPowerOff>
            </li>
            <li Class="ColonyManagerRedux.CompProperties_ManagerStation">
                <speed>500</speed>
            </li>
            <li Class="CompProperties_Forbiddable" />
            <li Class="CompProperties_Flickable" />
            <li Class="CompProperties_Breakdownable" />
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>ToolCabinet</li>
                </linkableFacilities>
            </li>
        </comps>
        <researchPrerequisites>
            <li>ManagingSoftware</li>
        </researchPrerequisites>
        <placeWorkers>
            <li>PlaceWorker_ShowFacilitiesConnections</li>
            <li>PlaceWorker_PreventInteractionSpotOverlap</li>
        </placeWorkers>
    </ThingDef>
    <ThingDef ParentName="BuildingBase">
        <defName>CM_AIManager</defName>
        <label>AI manager</label>
        <thingClass>ColonyManagerRedux.Building_AIManager</thingClass>
        <description>An enormous supercomputer capable of automously managing your colony. Claims that the AI has a malevolent psychopath subroutine are entirely false. We promise.</description>
        <uiIconScale>0.65</uiIconScale>
        <uiIconOffset>(0, 0.1)</uiIconOffset>
        <graphicData>
            <texPath>Buildings/AI_ManagerStation</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>(3.6, 3.6)</drawSize>
            <drawOffset>(0, 0, 0.1)</drawOffset>
        </graphicData>
        <rotatable>false</rotatable>
        <altitudeLayer>Building</altitudeLayer>
        <minifiedDef>MinifiedThing</minifiedDef>
        <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
        <thingCategories>
            <li>BuildingsProduction</li>
        </thingCategories>
        <costList>
            <Plasteel>75</Plasteel>
            <Silver>5</Silver>
            <AIPersonaCore>1</AIPersonaCore>
        </costList>
        <fillPercent>1</fillPercent>
        <useHitPoints>True</useHitPoints>
        <statBases>
            <WorkToBuild>5000</WorkToBuild>
            <MaxHitPoints>100</MaxHitPoints>
            <Flammability>0.5</Flammability>
            <Mass>65</Mass>
        </statBases>
        <selectable>true</selectable>
        <size>(2, 2)</size>
        <designationCategory>Production</designationCategory>
        <passability>PassThroughOnly</passability>
        <pathCost>100</pathCost>
        <tickerType>Normal</tickerType>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>750</basePowerConsumption>
                <idlePowerDraw>250</idlePowerDraw>
                <shortCircuitInRain>true</shortCircuitInRain>
                <soundPowerOn>Power_OnSmall</soundPowerOn>
                <soundPowerOff>Power_OffSmall</soundPowerOff>
            </li>
            <li Class="CompProperties_Glower">
                <compClass>ColonyManagerRedux.CompGlowerAIManager</compClass>
                <glowRadius>1</glowRadius>
                <glowColor>(110,186,255,0)</glowColor>
            </li>
            <li Class="CompProperties_HeatPusher">
                <compClass>CompHeatPusherPowered</compClass>
                <heatPerSecond>3</heatPerSecond>
            </li>
            <li Class="CompProperties_Forbiddable" />
            <li Class="CompProperties_Flickable" />
            <li Class="CompProperties_Breakdownable" />
            <li Class="ColonyManagerRedux.CompProperties_ManagerStation" />
        </comps>
        <researchPrerequisites>
            <li>AdvancedManagingSoftware</li>
        </researchPrerequisites>
        <building>
            <buildingTags>
                <li>Production</li>
            </buildingTags>
        </building>
    </ThingDef>
</Defs>
