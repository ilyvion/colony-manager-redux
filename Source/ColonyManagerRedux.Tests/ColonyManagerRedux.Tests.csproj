        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Hunting.GetMeatInDesignationsCoroutine" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Hunting.GetLeatherInDesignationsCoroutine" />
