<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <UseLaboratory>true</UseLaboratory>
        <RootNamespace>ColonyManagerRedux.Tests</RootNamespace>
        <AssemblyName>ColonyManagerRedux.Tests</AssemblyName>
    </PropertyGroup>
    <!--
        Without the DevTools reference (see below), this project has no Publicize items of its
        own, so Krafs.Publicizer's generated IgnoresAccessChecksToAttribute merely shadows the
        one already made public inside the referenced ColonyManagerRedux assembly; CS0436 is
        harmless here.
    -->
    <PropertyGroup Condition="'$(RimWorldVersion)' != '1.6' And '$(RimWorldVersion)' != '1.7'">
        <NoWarn>$(NoWarn);CS0436</NoWarn>
    </PropertyGroup>
    <!--
        Dev-only test assembly, built and run in-game via DevTools. Its output is placed in
        <version>/Assemblies next to the mod assembly, where DevTools discovers its [TestFixture]
        classes.

        It's listed in ColonyManagerRedux.sln so it always builds locally (default Configuration
        is Debug, see .vscode/build_config.sh), but ColonyManagerRedux.sln deliberately omits a
        Release|Any CPU.Build.0 line for this project's GUID, so a Release-configuration build
        (what CI/release always use, per rimworld-utils' build_mod.yml) skips building it
        entirely; its output never lands in a shipped release.

        DevTools only supports RimWorld 1.6 and 1.7, so for any other RimWorldVersion this project
        builds as an empty assembly: both the test sources and the DevTools reference are
        excluded below. DevTools.dll is built into <version>/Assemblies.
    -->
    <ItemGroup>
        <ProjectReference Include="..\ColonyManagerRedux\ColonyManagerRedux.csproj">
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </ProjectReference>
        <ProjectReference Include="..\ColonyManagerRedux.Managers\ColonyManagerRedux.Managers.csproj">
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>
    <ItemGroup Condition="'$(RimWorldVersion)' == '1.6' Or '$(RimWorldVersion)' == '1.7'">
        <Publicize Include="Assembly-CSharp:Verse.CrossRefHandler.loadedObjectDirectory" />
        <Publicize Include="ColonyManagerRedux:ColonyManagerRedux.Settings._coroutineTicksBetweenOperations" />
        <Publicize Include="Assembly-CSharp:Verse.FogGrid.fogGrid" />
        <Publicize Include="Assembly-CSharp:Verse.ThingFilter.allowedDefs" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Hunting.AddRelevantGameDesignations" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Forestry.PlanClearAreaDesignations" />
        <Publicize Include="Assembly-CSharp:RimWorld.CompFlickable.wantSwitchOn" />
        <Publicize Include="Assembly-CSharp:RimWorld.Building_GravEngine.allConnectedSubstructure" />
        <Publicize Include="Assembly-CSharp:RimWorld.Building_GravEngine.substructureDirty" />
        <Publicize Include="Assembly-CSharp:RimWorld.Planet.Gravship.things" />
        <Publicize Include="ColonyManagerRedux:ColonyManagerRedux.ManagerTab._truncateCache" />
        <Publicize Include="Assembly-CSharp:RimWorld.Pawn_PlayerSettings.master" />
        <Publicize Include="Assembly-CSharp:RimWorld.PawnTable.dirty" />
        <Publicize Include="Assembly-CSharp:RimWorld.PawnTable.CalculateHeaderHeight" />
        <Publicize Include="Assembly-CSharp:Verse.RecipeDef.ingredientValueGetterClass" />
        <Publicize Include="Assembly-CSharp:Verse.Game.currentMapIndex" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerTab_Overview.pawnOverviewTable" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerTab_Livestock.animalsTameTable" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerTab_Livestock.animalsWildTable" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Mining.WouldCollapseIfSupportDestroyed" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Mining.AddDesignation" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Mining.PlanReduceDesignations" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Mining.ExecuteReduceDesignations" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Mining.ExecuteAddDesignations" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Mining.ExecuteDrillFlicks" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Hunting.AddDesignation" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Hunting.ExecuteAddDesignations" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Foraging.ExecuteAddDesignations" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Foraging.GetCurrentDesignatedCountCoroutine" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Forestry.GetCurrentDesignatedCountCoroutine" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Forestry.ExecuteAddDesignations" />
