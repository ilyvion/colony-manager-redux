        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerDefaultSettings_Livestock.overrides" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerDefaultSettings_Livestock._currentLivestockSettingsTab" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerDefaultSettings_Livestock.currentOverrideTab" />
        <Publicize Include="Assembly-CSharp:RimWorld.PawnColumnWorker_WorkPriority.IsIncapableOfWholeWorkType" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Power._traderBuildings" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Power._batteryBuildings" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Power._traders" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Power._batteries" />
        <Publicize Include="ColonyManagerRedux:ColonyManagerRedux.ManagerJob._jobState" />
        <Publicize Include="ColonyManagerRedux:ColonyManagerRedux.ManagerJob._jobCreatedTick" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Power.RefreshBuildingLists" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Power.RefreshCompLists" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Power._isRefreshingBuildingLists" />
        <Publicize Include="ColonyManagerRedux.Managers:ColonyManagerRedux.Managers.ManagerJob_Power._isRefreshingCompLists" />
        <ProjectReference
            Include="$(ProjectDependenciesBasePath)\Third-Party\DevTools\DevTools\DevTools.csproj"
            AdditionalProperties="RimWorldVersion=$(RimWorldVersion);OutDir=$(MSBuildThisFileDirectory)..\..\$(RimWorldVersion)\Assemblies\"
        >
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>
    <ItemGroup Condition="'$(RimWorldVersion)' != '1.6' And '$(RimWorldVersion)' != '1.7'">
        <Compile Remove="**/*.cs" />
    </ItemGroup>
</Project>
